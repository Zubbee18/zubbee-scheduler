# Timing threshold in minutes
TIMING_MIN=2

# Frontend URL(s) for CORS configuration (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# Threshold for dead-letter queue (DLQ) alerts (number of failed jobs)
DLQ_ALERT_THRESHOLD=10

# Recipient email address for DLQ alerts
ALERT_EMAIL=[EMAIL_ADDRESS]

# Enable demo scenarios in tests (set to 1 to run demo)
RUN_DEMO=0

# Persistent storage mount for SQLite (Coolify)
SQLITE_PATH=/data/database.db
